[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://Card.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(1, 1, 1, 1)
